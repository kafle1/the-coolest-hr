# Copy to .env and fill in. See the README for the full variable reference.

# ---- Required ----
# Matches the bundled docker-compose services (pnpm db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/niural_assessment?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Holds the rate limit counts. Also started by pnpm db:up
REDIS_URL="redis://localhost:6379"

# Admin workspace login + session cookie signing
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
SESSION_SIGNING_SECRET="generate-a-long-random-string"

# ---- AI provider (one of these is required) ----
AI_PROVIDER="auto"
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openai/gpt-4.1-mini"
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1-mini"
# Minimum AI fit score that auto-shortlists a candidate
# SCREENING_THRESHOLD="76"

# ---- Optional integrations ----
# Every block below is optional; when a credential is missing the matching
# service falls back to a local implementation and the pipeline keeps running.

# Email (Resend) — falls back to writing emails into the database
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="hiring@example.com"

# Google Calendar — falls back to managing slots in Postgres only
# GOOGLE_CALENDAR_AUTH_MODE="oauth-refresh"
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# GOOGLE_OAUTH_REFRESH_TOKEN=""
# GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# GOOGLE_CALENDAR_ID=""
# INTERVIEWER_NAME=""
# INTERVIEWER_EMAIL=""

# Slack — falls back to logging events into the database
# SLACK_BOT_TOKEN=""
# SLACK_ADMIN_USER_TOKEN=""
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""
# SLACK_REDIRECT_URI=""
# SLACK_SIGNING_SECRET=""
# SLACK_TEAM_ID=""
# SLACK_HR_CHANNEL_ID=""
# SLACK_DEFAULT_CHANNEL_IDS=""

# Fireflies transcripts — falls back to pasting transcript text in the admin UI
# FIREFLIES_API_KEY=""
